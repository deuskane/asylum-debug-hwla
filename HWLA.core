  #---------------------------------------
  # Configuration same_period : 16 probes, 128 samples, 64 pre-trigger samples, no timestamp, every sample stored, same period for both clocks
  #---------------------------------------
  sim_same_period_reset_values:
    << : *sim_hwla
    description     : Simulation of hwla (same_period), outputs after the reset
    parameters      :
      - NB_PROBE=16
      - DEPTH=128
      - PRE_TRIGGER=64
      - TIMESTAMP_WIDTH=0
      - CHANGE_ONLY=false
      - TDATA_WIDTH=0
      - TRIG_CLK_PERIOD=10
      - EXTRACT_CLK_PERIOD=10
      - TEST=reset_values

  sim_same_period_not_armed:
    << : *sim_hwla
    description     : Simulation of hwla (same_period), trigger ignored while not armed
    parameters      :
