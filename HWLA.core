      - TDATA_WIDTH=8
      - TRIG_CLK_PERIOD=26
      - EXTRACT_CLK_PERIOD=8
      - TEST=async_reset


  #---------------------------------------
  # Configuration pre_trigger_max : 33 probes, 64 samples, no post-trigger sample, 4-bit timestamp, changes only, 3 beats of 16 bits, extraction clock much slower
  #---------------------------------------
  sim_pre_trigger_max_reset_values:
    << : *sim_hwla
    description     : Simulation of hwla (pre_trigger_max), outputs after the reset
    parameters      :
      - NB_PROBE=33
      - DEPTH=64
      - PRE_TRIGGER=63
      - TIMESTAMP_WIDTH=4
      - CHANGE_ONLY=true
      - TDATA_WIDTH=16
      - TRIG_CLK_PERIOD=6
      - EXTRACT_CLK_PERIOD=34
      - TEST=reset_values

  sim_pre_trigger_max_not_armed:
    << : *sim_hwla
    description     : Simulation of hwla (pre_trigger_max), trigger ignored while not armed
    parameters      :
      - NB_PROBE=33
      - DEPTH=64
      - PRE_TRIGGER=63
      - TIMESTAMP_WIDTH=4
      - CHANGE_ONLY=true
      - TDATA_WIDTH=16
      - TRIG_CLK_PERIOD=6
      - EXTRACT_CLK_PERIOD=34
      - TEST=not_armed

  sim_pre_trigger_max_capture:
    << : *sim_hwla
    description     : Simulation of hwla (pre_trigger_max), single capture
    parameters      :
      - NB_PROBE=33
