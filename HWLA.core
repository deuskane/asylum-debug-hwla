      - PRE_TRIGGER=63
      - TIMESTAMP_WIDTH=4
      - CHANGE_ONLY=true
      - TDATA_WIDTH=16
      - TRIG_CLK_PERIOD=6
      - EXTRACT_CLK_PERIOD=34
      - TEST=back_pressure

  sim_pre_trigger_max_stall:
    << : *sim_hwla
    description     : Simulation of hwla (pre_trigger_max), long stall, arm_i and trigger ignored during the extraction
    parameters      :
