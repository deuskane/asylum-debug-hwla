      - DEPTH=64
      - PRE_TRIGGER=63
      - TIMESTAMP_WIDTH=4
      - CHANGE_ONLY=true
      - TDATA_WIDTH=16
      - TRIG_CLK_PERIOD=6
      - EXTRACT_CLK_PERIOD=34
      - TEST=pre_trigger_ignored

  sim_pre_trigger_max_level_trigger:
