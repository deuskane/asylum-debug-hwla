CAPI=2:

#-----------------------------------------------------------------------------
# Title      : HWLA Core file
# Project    : Asylum
#-----------------------------------------------------------------------------
# File       : HWLA.core
# Author     : mrosiere
#-----------------------------------------------------------------------------
# Description: Hardware Logic Analyzer : capture in a trigger clock domain,
#              extraction on an AXI-Stream master in another clock domain
#-----------------------------------------------------------------------------
# Copyright (c) 2026
#-----------------------------------------------------------------------------
# Revisions  :
# Date        Version  Author   Description
# 2026-10-22  1.0.0    mrosiere First Release
#-----------------------------------------------------------------------------

name        : asylum:debug:HWLA:1.0.0
description : Hardware Logic Analyzer

#=========================================
filesets:
#=========================================

  #---------------------------------------
  hdl:
  #---------------------------------------
    files        :
      - hdl/hwla_pkg.vhd
      - hdl/hwla_ram.vhd
      - hdl/hwla_trigger.vhd
      - hdl/hwla_extract.vhd
      - hdl/hwla.vhd
    file_type    : vhdlSource
    logical_name : asylum
    depend       :
      - asylum:utils:pkg
      - asylum:target:techmap

  #---------------------------------------
  sim_basic:
  #---------------------------------------
    files        :
      - sim/basic/tb_hwla.vhd
    file_type    : vhdlSource-2008
    depend       :
      - bitvis:verification:uvvm

  #---------------------------------------
  # Lint Files (pre_run hook of lint_ghdl_synth_*)
  #---------------------------------------
  files_lint:
    files:
      - syn/ghdl/hwla_synth_top.vhd
      - syn/ghdl/ghdl_synth.sh : {file_type : user, copyto : ghdl_synth.sh}
      - syn/ghdl/ghdl_synth.mk : {file_type : user, copyto : ghdl_synth.mk}
    file_type : vhdlSource-2008

#=========================================
targets:
#=========================================

  #---------------------------------------
  default: &default
  #---------------------------------------
    description     : Default Target
    filesets        :
      - hdl
    toplevel        : hwla
    default_tool    : ghdl

  #---------------------------------------
  # Lint : -Wall analysis and elaboration (empty simulation)
  #---------------------------------------
  lint_ghdl : &lint_ghdl
    << : *default
    description     : Lint with GHDL (-Wall analysis and elaboration of hwla_synth_top)
    toplevel        : hwla_synth_top
    filesets_append : [files_lint]
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall"]

  #---------------------------------------
  # Synthesis check : -Wall analysis, ghdl --synth -Wall and elaboration
  # (no simulation) of hwla_synth_top with the generics of the target.
  # The pre_run hook adds syn/ghdl/ghdl_synth.mk to the edalize Makefile.
  # FuseSoC merges tools in depth : analyze_options comes from lint_ghdl.
  #---------------------------------------
  lint_ghdl_synth_default : &lint_ghdl_synth
    << : *lint_ghdl
    description     : Synthesis check of hwla_synth_top, default generics (8 probes, 256 samples, 128 pre-trigger samples)
    tools :
      ghdl :
        run_options     : ["--no-run"]
    hooks :
      pre_run : [ghdl_synth]

  #---------------------------------------
  lint_ghdl_synth_pre_trigger_0 :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of hwla_synth_top, no pre-trigger sample
    parameters      :
      - PRE_TRIGGER=0

  #---------------------------------------
  lint_ghdl_synth_pre_trigger_max :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of hwla_synth_top, no post-trigger sample
    parameters      :
      - PRE_TRIGGER=255

  #---------------------------------------
  lint_ghdl_synth_min :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of hwla_synth_top, smallest configuration (1 probe, 2 samples)
    parameters      :
      - NB_PROBE=1
      - DEPTH=2
      - PRE_TRIGGER=1

  #---------------------------------------
  # Simulation : tb_hwla with the generics of the target
  #---------------------------------------
  sim_basic: &sim_basic
    << : *default
    description     : Simulation of hwla with the UVVM AXI-Stream BFM, 12 probes, 32 samples, 10 pre-trigger samples, extraction clock slower
    filesets_append :
      - sim_basic
    toplevel        : tb_hwla
    default_tool    : ghdl
    parameters      :
      - NB_PROBE=12
      - DEPTH=32
      - PRE_TRIGGER=10
      - TRIG_CLK_PERIOD=10
      - EXTRACT_CLK_PERIOD=18
    tools :
      ghdl :
        analyze_options :
          - "$(GHDL_ANALYZE_OPTION)"
          - "-Wall"
          - "-frelaxed"
        run_options     :
          - "$(GHDL_RUN_OPTION)"
          - "--ieee-asserts=disable"

  #---------------------------------------
  sim_pre_trigger_0:
  #---------------------------------------
    << : *sim_basic
    description     : Simulation of hwla, 8 probes, 16 samples, no pre-trigger sample, extraction clock faster
    parameters      :
      - NB_PROBE=8
      - DEPTH=16
      - PRE_TRIGGER=0
      - TRIG_CLK_PERIOD=26
      - EXTRACT_CLK_PERIOD=8

  #---------------------------------------
  sim_pre_trigger_max:
  #---------------------------------------
    << : *sim_basic
    description     : Simulation of hwla, 33 probes, 64 samples, no post-trigger sample, extraction clock much slower
    parameters      :
      - NB_PROBE=33
      - DEPTH=64
      - PRE_TRIGGER=63
      - TRIG_CLK_PERIOD=6
      - EXTRACT_CLK_PERIOD=34

  #---------------------------------------
  sim_same_period:
  #---------------------------------------
    << : *sim_basic
    description     : Simulation of hwla, 16 probes, 128 samples, 64 pre-trigger samples, same period for both clocks
    parameters      :
      - NB_PROBE=16
      - DEPTH=128
      - PRE_TRIGGER=64
      - TRIG_CLK_PERIOD=10
      - EXTRACT_CLK_PERIOD=10

#=========================================
scripts:
#=========================================

  #---------------------------------------
  # pre_run hook of lint_ghdl_synth_* (cwd = work_root)
  #---------------------------------------
  ghdl_synth :
    cmd : [bash, ghdl_synth.sh]

#=========================================
parameters :
#=========================================

  #---------------------------------------
  # Generics of hwla_synth_top (lint_ghdl_synth_*) and of tb_hwla (sim_*)
  #---------------------------------------
  NB_PROBE :
    description : Number of probes (width of a sample)
    datatype    : int
    default     : 8
    paramtype   : generic

  DEPTH :
    description : Number of samples of a capture (power of 2)
    datatype    : int
    default     : 256
    paramtype   : generic

  PRE_TRIGGER :
    description : Number of samples before the trigger sample (0 to DEPTH-1)
    datatype    : int
    default     : 128
    paramtype   : generic

  #---------------------------------------
  # Generics of tb_hwla (sim_*)
  #---------------------------------------
  TRIG_CLK_PERIOD :
    description : Period of the trigger clock (ns, even)
    datatype    : int
    default     : 10
    paramtype   : generic

  EXTRACT_CLK_PERIOD :
    description : Period of the extraction clock (ns, even)
    datatype    : int
    default     : 18
    paramtype   : generic
