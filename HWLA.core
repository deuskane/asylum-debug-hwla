name        : asylum:debug:HWLA:1.0.0
description : Hardware Logic Analyzer

#=========================================
filesets:
#=========================================

  #---------------------------------------
  hdl:
  #---------------------------------------
    files        :
      - hdl/hwla_pkg.vhd
      - hdl/hwla_ram.vhd
      - hdl/hwla_trigger.vhd
      - hdl/hwla_extract.vhd
      - hdl/hwla.vhd
    file_type    : vhdlSource
    logical_name : asylum
    depend       :
      - asylum:utils:pkg
      - asylum:target:techmap

#=========================================
targets:
#=========================================

  #---------------------------------------
  default: &default
  #---------------------------------------
    description     : Default Target
    filesets        :
      - hdl
    toplevel        : hwla
    default_tool    : ghdl
