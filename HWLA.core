      - CHANGE_ONLY=true
      - TDATA_WIDTH=8
      - TRIG_CLK_PERIOD=26
      - EXTRACT_CLK_PERIOD=8
      - TEST=back_pressure

  sim_pre_trigger_0_stall:
    << : *sim_hwla
    description     : Simulation of hwla (pre_trigger_0), long stall, arm_i and trigger ignored during the extraction
    parameters      :
      - NB_PROBE=8
      - DEPTH=16
      - PRE_TRIGGER=0
      - TIMESTAMP_WIDTH=8
      - CHANGE_ONLY=true
      - TDATA_WIDTH=8
      - TRIG_CLK_PERIOD=26
      - EXTRACT_CLK_PERIOD=8
      - TEST=stall

  sim_pre_trigger_0_continuous:
    << : *sim_hwla
    description     : Simulation of hwla (pre_trigger_0), continuous captures (arm_i held high)
    parameters      :
      - NB_PROBE=8
      - DEPTH=16
      - PRE_TRIGGER=0
      - TIMESTAMP_WIDTH=8
      - CHANGE_ONLY=true
      - TDATA_WIDTH=8
      - TRIG_CLK_PERIOD=26
      - EXTRACT_CLK_PERIOD=8
      - TEST=continuous

  sim_pre_trigger_0_sparse:
    << : *sim_hwla
    description     : Simulation of hwla (pre_trigger_0), sparse probes
    parameters      :
