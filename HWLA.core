      - PRE_TRIGGER=64
      - TIMESTAMP_WIDTH=0
      - CHANGE_ONLY=false
      - TDATA_WIDTH=0
      - TRIG_CLK_PERIOD=10
      - EXTRACT_CLK_PERIOD=10
      - TEST=late_trigger

