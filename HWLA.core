    description     : Simulation of hwla (pre_trigger_0), trigger after 3 turns of the circular buffer
    parameters      :
      - NB_PROBE=8
      - DEPTH=16
      - PRE_TRIGGER=0
      - TIMESTAMP_WIDTH=8
      - CHANGE_ONLY=true
      - TDATA_WIDTH=8
      - TRIG_CLK_PERIOD=26
      - EXTRACT_CLK_PERIOD=8
      - TEST=late_trigger

  sim_pre_trigger_0_back_pressure:
    << : *sim_hwla
    description     : Simulation of hwla (pre_trigger_0), random back pressure
    parameters      :
      - NB_PROBE=8
      - DEPTH=16
      - PRE_TRIGGER=0
