      - TEST=async_reset

  #---------------------------------------
  # HWLA on a UART : tb_hwla_uart with the generics of the target, then the
  # VCD rebuilt from the UART bytes by tools/hwla2vcd.py is checked against
  # the probes of the testbench
  #---------------------------------------
  sim_uart: &sim_uart
    << : *default
    description     : Simulation of hwla connected to uart_tx_axis (UVVM UART BFM), 32 samples, 8 pre-trigger samples, 16-bit timestamp, changes only, VCD rebuilt from the UART bytes by tools/hwla2vcd.py and checked
    filesets_append :
      - sim_uart
    toplevel        : tb_hwla_uart
    default_tool    : ghdl
    parameters      :
      - DEPTH=32
      - PRE_TRIGGER=8
      - TIMESTAMP_WIDTH=16
      - CHANGE_ONLY=true
    tools :
      ghdl :
        analyze_options :
          - "$(GHDL_ANALYZE_OPTION)"
          - "-Wall"
          - "-frelaxed"
        run_options     :
          - "$(GHDL_RUN_OPTION)"
          - "--ieee-asserts=disable"
    hooks :
      post_run : [hwla2vcd, check_vcd]

  #---------------------------------------
  sim_uart_no_timestamp:
  #---------------------------------------
    << : *sim_uart
    description     : Simulation of hwla connected to uart_tx_axis, 64 samples, 16 pre-trigger samples, no timestamp, every sample stored (1 byte per sample), VCD rebuilt and checked
    parameters      :
      - DEPTH=64
      - PRE_TRIGGER=16
      - TIMESTAMP_WIDTH=0
      - CHANGE_ONLY=false

#=========================================
scripts:
#=========================================

  #---------------------------------------
  # post_run hooks of sim_uart* (cwd = work_root) : the configuration of
  # the HWLA (hwla2vcd.args) and the list of the VCD files (check_vcd.args)
  # are written by tb_hwla_uart from its generics
  #---------------------------------------
  hwla2vcd :
    cmd : [python3, hwla2vcd.py, hwla_uart.hex, --format, hex, --args-file, hwla2vcd.args, --bus, probe, -o, hwla_uart.vcd]

  check_vcd :
    cmd : [python3, check_vcd.py, --args-file, check_vcd.args]

  #---------------------------------------
  # pre_run hook of lint_ghdl_synth_* (cwd = work_root)
  #---------------------------------------
  ghdl_synth :
    cmd : [bash, ghdl_synth.sh]

#=========================================
parameters :
#=========================================

  #---------------------------------------
  # Generics of hwla_synth_top (lint_ghdl_synth_*) and of tb_hwla (sim_*)
  #---------------------------------------
  NB_PROBE :
    description : Number of probes
    datatype    : int
    default     : 8
    paramtype   : generic

  DEPTH :
    description : Number of stored samples of a capture (power of 2)
    datatype    : int
    default     : 256
    paramtype   : generic

  PRE_TRIGGER :
    description : Number of stored samples before the trigger sample (0 to DEPTH-1)
    datatype    : int
    default     : 128
    paramtype   : generic

  TIMESTAMP_WIDTH :
    description : Width of the timestamp of a sample (0 = no timestamp)
    datatype    : int
    default     : 16
    paramtype   : generic

  CHANGE_ONLY :
    description : true, store a sample only if the probes changed ; false, store every sample
    datatype    : bool
    default     : true
    paramtype   : generic

  TDATA_WIDTH :
    description : Width of the AXI-Stream tdata (multiple of 8), 0 = one beat per sample
    datatype    : int
    default     : 0
    paramtype   : generic

  #---------------------------------------
  # Generics of tb_hwla (sim_*)
  #---------------------------------------
  TRIG_CLK_PERIOD :
    description : Period of the trigger clock (ns, even)
    datatype    : int
    default     : 10
    paramtype   : generic

  EXTRACT_CLK_PERIOD :
    description : Period of the extraction clock (ns, even)
    datatype    : int
    default     : 18
    paramtype   : generic

  TEST :
    description : Test of tb_hwla (one test per simulation)
    datatype    : str
    default     : capture
    paramtype   : generic
