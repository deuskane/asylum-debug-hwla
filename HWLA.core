    description     : Simulation of hwla (pre_trigger_max), level trigger already high at the arm
    parameters      :
      - NB_PROBE=33
      - DEPTH=64
      - PRE_TRIGGER=63
      - TIMESTAMP_WIDTH=4
      - CHANGE_ONLY=true
      - TDATA_WIDTH=16
      - TRIG_CLK_PERIOD=6
      - EXTRACT_CLK_PERIOD=34
      - TEST=level_trigger

  sim_pre_trigger_max_late_trigger:
