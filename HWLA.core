  sim_same_period_level_trigger:
    << : *sim_hwla
    description     : Simulation of hwla (same_period), level trigger already high at the arm
    parameters      :
      - NB_PROBE=16
      - DEPTH=128
      - PRE_TRIGGER=64
      - TIMESTAMP_WIDTH=0
      - CHANGE_ONLY=false
