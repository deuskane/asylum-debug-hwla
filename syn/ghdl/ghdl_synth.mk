#-----------------------------------------------------------------------------
# Title      : ghdl --synth rule for the Makefile generated by edalize (ghdl)
# Project    : Asylum
#-----------------------------------------------------------------------------
# File       : ghdl_synth.mk
# Author     : mrosiere
#-----------------------------------------------------------------------------
# Description: Included at the end of the Makefile generated by edalize by
#              ghdl_synth.sh (pre_run hook of the lint_ghdl_synth_* targets).
#              Makes "make run" (run step of fusesoc) synthesize the toplevel
#              with the options of the fusesoc target :
#              - STD, ANALYZE_OPTIONS, TOPLEVEL_LIBS, TOPLEVEL : edalize
#                Makefile (vhdl standard, tools/ghdl/analyze_options,
#                libraries, toplevel)
#              - EXTRA_OPTIONS : generics of the target (parameters), given
#                by edalize on the make run command line
#              - EDALIZE_LAUNCHER : launcher of the ghdl commands
#              Writes $(TOPLEVEL)_synth.vhd (netlist) and
#              $(TOPLEVEL)_synth.log, prints the warnings, fails if the
#              synthesis fails (ghdl --synth rejects a latch, unless
#              GHDL_SYNTH_OPTIONS has --latches).
#-----------------------------------------------------------------------------
# Copyright (c) 2026
#-----------------------------------------------------------------------------
# Revisions  :
# Date        Version  Author   Description
# 2026-10-21  1.0      mrosiere Created
#-----------------------------------------------------------------------------

GHDL_SYNTH_OPTIONS  ?=
GHDL_SYNTH_NETLIST  ?= $(TOPLEVEL)_synth.vhd
GHDL_SYNTH_LOG      ?= $(TOPLEVEL)_synth.log

#--------------------------------------------------------
# Synthesis before the ghdl -r of the run rule
run : ghdl_synth
#--------------------------------------------------------

#--------------------------------------------------------
ghdl_synth : $(TOPLEVEL)
#--------------------------------------------------------
	$(EDALIZE_LAUNCHER) ghdl --synth $(STD) $(ANALYZE_OPTIONS) $(GHDL_SYNTH_OPTIONS) $(TOPLEVEL_LIBS) $(EXTRA_OPTIONS) $(TOPLEVEL) > $(GHDL_SYNTH_NETLIST) 2> $(GHDL_SYNTH_LOG) \
	|| { sed 's/^/    /' $(GHDL_SYNTH_LOG); echo "ghdl_synth : FAIL"; exit 1; }
	@grep -i "warning" $(GHDL_SYNTH_LOG) | sed 's/^/    /' || true
	@echo "ghdl_synth : PASS ($$(grep -ci "warning" $(GHDL_SYNTH_LOG)) warnings, netlist $(GHDL_SYNTH_NETLIST))"

.PHONY : ghdl_synth
